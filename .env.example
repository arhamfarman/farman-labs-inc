# Copy to .env.local and fill in. Every value is optional in development:
# without them the intake form still validates, then logs the lead to the server console.

# Supabase: the intake form inserts into the `leads` table (see supabase/leads.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: notification to the founder and an auto-reply to the sender
RESEND_API_KEY=
LEAD_NOTIFY_TO=arham@farmanlabs.com
LEAD_FROM="Farman Labs <hello@farmanlabs.com>"

# Cloudflare Turnstile spam protection (the honeypot field always runs)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cal.com event for the discovery call, e.g. farmanlabs/30min
NEXT_PUBLIC_CAL_LINK=
