{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard
  "name": "farman-labs-inc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by OpenNext for internal requests; must match "name" above
      "binding": "WORKER_SELF_REFERENCE",
      "service": "farman-labs-inc"
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  // Wrangler creates the DNS records and certificates for these on deploy
  "routes": [
    { "pattern": "farmanlabs.com", "custom_domain": true },
    { "pattern": "www.farmanlabs.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
